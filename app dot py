import os, requests
from flask import Flask, request

app = Flask(__name__)

VERIFY_TOKEN = os.environ.get("VERIFY_TOKEN", "moses_oem_parts_2026")
PAGE_ACCESS_TOKEN = os.environ.get("PAGE_ACCESS_TOKEN", "")
WHATSAPP_TOKEN = os.environ.get("WHATSAPP_TOKEN", "")
WHATSAPP_PHONE_ID = os.environ.get("WHATSAPP_PHONE_ID", "")
OPENAI_KEY = os.environ.get("OPENAI_KEY", "")

CATALOG = {
    "headlights": ["VW Golf 6", "BMW F-series", "Audi A3", "Audi RS6 C8", "Toyota RAV4", "Mercedes CLE C236"],
    "led modules": ["BMW G20 fog lights", "Audi Q5", "VW Tiguan", "Mercedes C-Class"],
    "bumpers": ["Porsche Boxster", "BMW G20", "Audi A4", "Toyota Corolla", "Mercedes A-Class", "Mercedes E-Class"],
    "parts": ["modules", "headlights", "bumpers", "fog lights", "taillights"]
}

def ai_reply(text):
    t = text.lower()
    for k, v in CATALOG.items():
        if k in t:
            return f"We stock {k}: {', '.join(v)}. WhatsApp +27 63 451 8666 for prices and stock."
    if "price" in t or "cost" in t:
        return "Prices depend on the exact part and model. Send the part name and car details on WhatsApp +27 63 451 8666."
    return "Hi, Moses OEM Parts here. We sell headlights, LED modules, bumpers and OEM parts for VW, BMW, Audi, Toyota, Mercedes and more. What do you need?"

def ai_reply_smart(text):
    if not OPENAI_KEY:
        return ai_reply(text)
    try:
        r = requests.post(
            "https://api.openai.com/v1/chat/completions",
            headers={"Authorization": f"Bearer {OPENAI_KEY}", "Content-Type": "application/json"},
            json={
                "model": "gpt-4o-mini",
                "max_tokens": 150,
                "messages": [
                    {"role": "system", "content": "You are Moses OEM Parts, a South African car parts seller. WhatsApp +27 63 451 8666, email mukasamosesimports@gmail.com. Sell headlights, LED modules, bumpers, OEM parts for VW, BMW, Audi, Toyota, Mercedes, Porsche, Nissan, Jaguar, Land Rover, McLaren, Lamborghini, GTR. Be short, always end with the WhatsApp number."},
                    {"role": "user", "content": text}
                ]
            },
            timeout=20
        )
        return r.json()["choices"][0]["message"]["content"]
    except Exception:
        return ai_reply(text)

def send_messenger(uid, text):
    if not PAGE_ACCESS_TOKEN:
        return
    requests.post(
        f"https://graph.facebook.com/v19.0/me/messages?access_token={PAGE_ACCESS_TOKEN}",
        json={"recipient": {"id": uid}, "message": {"text": text}},
        timeout=15
    )

def send_whatsapp(to, text):
    if not (WHATSAPP_TOKEN and WHATSAPP_PHONE_ID):
        return
    requests.post(
        f"https://graph.facebook.com/v19.0/{WHATSAPP_PHONE_ID}/messages",
        headers={"Authorization": f"Bearer {WHATSAPP_TOKEN}"},
        json={
            "messaging_product": "whatsapp",
            "to": to,
            "type": "text",
            "text": {"body": text}
        },
        timeout=15
    )

@app.route("/webhook", methods=["GET", "POST"])
def webhook():
    if request.method == "GET":
        if request.args.get("hub.mode") == "subscribe" and request.args.get("hub.verify_token") == VERIFY_TOKEN:
            return request.args.get("hub.challenge"), 200
        return "bad", 403
    data = request.get_json(force=True, silent=True) or {}
    for e in data.get("entry", []):
        for m in e.get("messaging", []):
            sender = m.get("sender", {}).get("id")
            msg = m.get("message", {})
            if sender and "text" in msg and not msg.get("is_echo"):
                send_messenger(sender, ai_reply_smart(msg["text"]))
        for c in e.get("changes", []):
            v = c.get("value", {})
            if c.get("field") == "messages":
                for msg in v.get("messages", []):
                    if msg.get("type") == "text":
                        send_whatsapp(msg["from"], ai_reply_smart(msg["text"]["body"]))
    return "ok", 200

@app.route("/")
def home():
    return "Moses OEM Parts bot is live."

if __name__ == "__main__":
    app.run(host="0.0.0.0", port=int(os.environ.get("PORT", 5000)))
